<!-- Enhanced Teacher Profile Edit Modal -->
<div x-show="showProfileModal" 
     x-cloak
     class="fixed inset-0 bg-black/50 backdrop-blur-sm flex items-center justify-center z-50 overflow-y-auto p-4"
     @click.self="closeProfileModal()">
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-2xl w-full max-w-4xl my-8 max-h-[90vh] flex flex-col overflow-hidden">
        <!-- Header -->
        <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200 dark:border-gray-700 flex-shrink-0">
            <div>
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Edit Profile</h3>
                <p class="text-sm text-gray-500 dark:text-gray-400">Update your professional information</p>
            </div>
            <button @click="closeProfileModal()" class="p-2 text-gray-400 hover:text-gray-600 dark:hover:text-gray-200">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>

        <!-- Form -->
        <form id="editProfileForm" class="px-6 py-6 space-y-6 overflow-y-auto flex-1">
            <!-- Personal Information -->
            <div>
                <h4 class="text-sm font-semibold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
                    <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                    Personal Information
                </h4>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">First Name *</label>
                        <input type="text" name="firstName" :value="user.firstName" required 
                               class="w-full px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 dark:bg-gray-700 dark:text-white">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Last Name *</label>
                        <input type="text" name="lastName" :value="user.lastName" required 
                               class="w-full px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 dark:bg-gray-700 dark:text-white">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Phone</label>
                        <input type="tel" name="phone" :value="user.phone" 
                               class="w-full px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 dark:bg-gray-700 dark:text-white">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Date of Birth</label>
                        <input type="text" name="dateOfBirth" :value="user.dateOfBirth" placeholder="dd/mm/yyyy"
                               class="w-full px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 dark:bg-gray-700 dark:text-white">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Gender</label>
                        <select name="gender" class="w-full px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 dark:bg-gray-700 dark:text-white">
                            <option value="unspecified" :selected="user.gender === 'unspecified'">Prefer not to say</option>
                            <option value="male" :selected="user.gender === 'male'">Male</option>
                            <option value="female" :selected="user.gender === 'female'">Female</option>
                            <option value="other" :selected="user.gender === 'other'">Other</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Blood Group</label>
                        <select name="bloodGroup" class="w-full px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 dark:bg-gray-700 dark:text-white">
                            <option value="">Select</option>
                            <option value="A+" :selected="user.bloodGroup === 'A+'">A+</option>
                            <option value="A-" :selected="user.bloodGroup === 'A-'">A-</option>
                            <option value="B+" :selected="user.bloodGroup === 'B+'">B+</option>
                            <option value="B-" :selected="user.bloodGroup === 'B-'">B-</option>
                            <option value="AB+" :selected="user.bloodGroup === 'AB+'">AB+</option>
                            <option value="AB-" :selected="user.bloodGroup === 'AB-'">AB-</option>
                            <option value="O+" :selected="user.bloodGroup === 'O+'">O+</option>
                            <option value="O-" :selected="user.bloodGroup === 'O-'">O-</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Emergency Contact</label>
                        <input type="tel" name="emergencyContact" :value="user.emergencyContact" placeholder="Emergency phone"
                               class="w-full px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 dark:bg-gray-700 dark:text-white">
                    </div>
                </div>
            </div>

            <!-- Bio -->
            <div>
                <h4 class="text-sm font-semibold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
                    <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                    Professional Bio
                </h4>
                <textarea name="bio" rows="3" :value="user.bio" placeholder="Write a professional bio..."
                          class="w-full px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 dark:bg-gray-700 dark:text-white"></textarea>
            </div>

            <!-- Expertise Areas -->
            <div>
                <h4 class="text-sm font-semibold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
                    <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
                    Research & Expertise Areas
                </h4>
                <input type="text" name="expertise" :value="user.expertise ? user.expertise.join(', ') : ''" placeholder="Machine Learning, Data Science, Web Development (comma-separated)"
                       class="w-full px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 dark:bg-gray-700 dark:text-white">
                <p class="text-xs text-gray-500 mt-1">Separate multiple areas with commas</p>
            </div>

            <!-- Social Links -->
            <div>
                <h4 class="text-sm font-semibold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
                    <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
                    Social & Academic Links
                </h4>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">LinkedIn URL</label>
                        <input type="url" name="linkedinUrl" :value="user.linkedinUrl" placeholder="https://linkedin.com/in/username"
                               class="w-full px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 dark:bg-gray-700 dark:text-white">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">GitHub URL</label>
                        <input type="url" name="githubUrl" :value="user.githubUrl" placeholder="https://github.com/username"
                               class="w-full px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 dark:bg-gray-700 dark:text-white">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Twitter / X URL</label>
                        <input type="url" name="twitterUrl" :value="user.twitterUrl" placeholder="https://twitter.com/username"
                               class="w-full px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 dark:bg-gray-700 dark:text-white">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Google Scholar URL</label>
                        <input type="url" name="scholarUrl" :value="user.scholarUrl" placeholder="https://scholar.google.com/citations?user=..."
                               class="w-full px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 dark:bg-gray-700 dark:text-white">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">ResearchGate URL</label>
                        <input type="url" name="researchGateUrl" :value="user.researchGateUrl" placeholder="https://researchgate.net/profile/..."
                               class="w-full px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 dark:bg-gray-700 dark:text-white">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">ORCID URL</label>
                        <input type="url" name="orcidUrl" :value="user.orcidUrl" placeholder="https://orcid.org/0000-0000-0000-0000"
                               class="w-full px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 dark:bg-gray-700 dark:text-white">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">YouTube Channel</label>
                        <input type="url" name="youtubeUrl" :value="user.youtubeUrl" placeholder="https://youtube.com/@channel"
                               class="w-full px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 dark:bg-gray-700 dark:text-white">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Portfolio / Website</label>
                        <input type="url" name="portfolioUrl" :value="user.portfolioUrl" placeholder="https://yourportfolio.com"
                               class="w-full px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 dark:bg-gray-700 dark:text-white">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Instagram URL</label>
                        <input type="url" name="instagramUrl" :value="user.instagramUrl" placeholder="https://instagram.com/username"
                               class="w-full px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 dark:bg-gray-700 dark:text-white">
                    </div>
                </div>
            </div>

            <!-- Address -->
            <div>
                <h4 class="text-sm font-semibold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
                    <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                    Address Information
                </h4>
                <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">House No / Building</label>
                        <input type="text" name="houseNo" :value="user.houseNo" placeholder="42-A, Sunrise Apt"
                               class="w-full px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 dark:bg-gray-700 dark:text-white">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Street / Locality</label>
                        <input type="text" name="street" :value="user.street" placeholder="MG Road"
                               class="w-full px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 dark:bg-gray-700 dark:text-white">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">City</label>
                        <input type="text" name="city" :value="user.city" placeholder="Ranchi"
                               class="w-full px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 dark:bg-gray-700 dark:text-white">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">District</label>
                        <input type="text" name="district" :value="user.district" placeholder="Ranchi"
                               class="w-full px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 dark:bg-gray-700 dark:text-white">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">State</label>
                        <input type="text" name="state" :value="user.state" placeholder="Jharkhand"
                               class="w-full px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 dark:bg-gray-700 dark:text-white">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">PIN Code</label>
                        <input type="text" name="pinCode" :value="user.pinCode" placeholder="834001"
                               class="w-full px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 dark:bg-gray-700 dark:text-white">
                    </div>
                </div>
            </div>
        </form>

        <!-- Footer -->
        <div class="flex justify-end space-x-4 px-6 py-4 border-t border-gray-200 dark:border-gray-700 flex-shrink-0">
            <button type="button" @click="closeProfileModal()" 
                    class="px-6 py-2 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700">
                Cancel
            </button>
            <button type="button" @click="submitProfileForm()" 
                    class="px-6 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700">
                Save Changes
            </button>
        </div>
    </div>
</div>

<script>
    async function submitProfileForm() {
        const form = document.getElementById('editProfileForm');
        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());
        
        // Convert expertise string to array
        if (data.expertise) {
            data.expertise = data.expertise.split(',').map(s => s.trim()).filter(s => s);
        }
        
        try {
            const response = await fetch('/api/profile', {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data),
                credentials: 'include'
            });
            
            if (response.ok) {
                alert('Profile updated successfully!');
                window.location.reload();
            } else {
                const error = await response.json();
                alert('Error: ' + (error.message || 'Failed to update profile'));
            }
        } catch (error) {
            console.error('Profile update error:', error);
            alert('Error updating profile. Please try again.');
        }
    }
</script>
