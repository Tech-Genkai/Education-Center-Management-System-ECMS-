<!-- Enhanced Teacher Profile Tab -->
<div class="space-y-6">
    <!-- Top Section: Profile Card + Personal Info -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Profile Picture & Quick Info Card -->
        <div class="glass-card rounded-xl shadow-md p-6">
            <div class="flex flex-col items-center">
                <!-- Profile Picture -->
                <div class="relative mb-4">
                    <img :src="user.profilePicture" 
                         alt="Profile" 
                         class="w-36 h-36 rounded-full object-cover border-4 border-green-200 dark:border-green-600 shadow-lg"
                         id="profilePicturePreview">
                    <div id="uploadSpinner" class="hidden absolute inset-0 bg-gray-900 bg-opacity-50 rounded-full flex items-center justify-center">
                        <svg class="animate-spin h-8 w-8 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                    </div>
                    <!-- Status Badge -->
                    <span class="absolute -bottom-1 -right-1 px-2 py-1 text-xs font-bold rounded-full shadow-lg"
                          :class="user.status === 'active' ? 'bg-green-500 text-white' : 'bg-red-500 text-white'"
                          x-text="user.status === 'active' ? 'Active' : 'Inactive'"></span>
                    <button type="button" 
                            onclick="document.getElementById('profilePictureInput').click()" 
                            class="absolute bottom-6 right-0 bg-green-600 hover:bg-green-700 text-white rounded-full p-2 shadow-lg transition-all hover:scale-110">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
                        </svg>
                    </button>
                    <input type="file" id="profilePictureInput" accept="image/jpeg,image/png,image/webp" class="hidden" onchange="handleProfilePictureChange(event)">
                </div>
                
                <!-- Name & Role -->
                <h2 class="text-xl font-bold text-gray-900 dark:text-white" x-text="user.name"></h2>
                <p class="text-sm text-green-600 dark:text-green-400 font-medium" x-text="user.designation || 'Faculty'"></p>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1" x-text="user.email"></p>
                
                <!-- Upload Controls -->
                <div id="uploadControls" class="hidden mt-4 space-y-2 w-full">
                    <button type="button" onclick="uploadProfilePicture()" id="uploadBtn" class="w-full px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 text-sm transition-colors">
                        Upload Photo
                    </button>
                    <button type="button" onclick="cancelProfilePictureUpload()" class="w-full px-4 py-2 bg-gray-300 dark:bg-gray-600 text-gray-700 dark:text-gray-200 rounded-lg hover:bg-gray-400 dark:hover:bg-gray-500 text-sm transition-colors">
                        Cancel
                    </button>
                </div>
                <p class="text-xs text-gray-400 mt-2">JPG, PNG or WEBP (Max 2MB)</p>

                <!-- Social Links -->
                <div class="flex items-center gap-3 mt-4">
                    <template x-if="user.linkedinUrl">
                        <a :href="user.linkedinUrl" target="_blank" class="p-2 bg-blue-100 dark:bg-blue-900/30 rounded-lg hover:bg-blue-200 dark:hover:bg-blue-800 transition">
                            <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                        </a>
                    </template>
                    <template x-if="user.githubUrl">
                        <a :href="user.githubUrl" target="_blank" class="p-2 bg-gray-100 dark:bg-gray-700 rounded-lg hover:bg-gray-200 dark:hover:bg-gray-600 transition">
                            <svg class="w-5 h-5 text-gray-800 dark:text-gray-200" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                        </a>
                    </template>
                    <template x-if="user.scholarUrl">
                        <a :href="user.scholarUrl" target="_blank" class="p-2 bg-blue-100 dark:bg-blue-900/30 rounded-lg hover:bg-blue-200 dark:hover:bg-blue-800 transition">
                            <svg class="w-5 h-5 text-blue-700 dark:text-blue-300" fill="currentColor" viewBox="0 0 24 24"><path d="M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 107 7 7 7 0 00-7-7z"/></svg>
                        </a>
                    </template>
                    <template x-if="user.portfolioUrl">
                        <a :href="user.portfolioUrl" target="_blank" class="p-2 bg-purple-100 dark:bg-purple-900/30 rounded-lg hover:bg-purple-200 dark:hover:bg-purple-800 transition">
                            <svg class="w-5 h-5 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
                        </a>
                    </template>
                </div>
            </div>
        </div>

        <!-- Personal Information -->
        <div class="lg:col-span-2 glass-card rounded-xl shadow-md p-6">
            <div class="flex items-center justify-between mb-6">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white flex items-center gap-2">
                    <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                    Personal Information
                </h3>
                <button @click="openProfileModal()" class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 text-sm font-medium transition flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                    Edit Profile
                </button>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                <div class="p-3 bg-gray-50 dark:bg-gray-800/50 rounded-lg">
                    <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">Teacher ID</p>
                    <p class="text-gray-900 dark:text-white font-medium text-sm" x-text="user.teacherId || '—'"></p>
                </div>
                <div class="p-3 bg-gray-50 dark:bg-gray-800/50 rounded-lg">
                    <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">Full Name</p>
                    <p class="text-gray-900 dark:text-white font-medium text-sm" x-text="user.name || '—'"></p>
                </div>
                <div class="p-3 bg-gray-50 dark:bg-gray-800/50 rounded-lg">
                    <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">Email</p>
                    <p class="text-gray-900 dark:text-white font-medium text-sm truncate" x-text="user.email || '—'"></p>
                </div>
                <div class="p-3 bg-gray-50 dark:bg-gray-800/50 rounded-lg">
                    <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">Institute Email</p>
                    <p class="text-gray-900 dark:text-white font-medium text-sm truncate" x-text="user.instituteEmail || '—'"></p>
                </div>
                <div class="p-3 bg-gray-50 dark:bg-gray-800/50 rounded-lg">
                    <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">Phone</p>
                    <p class="text-gray-900 dark:text-white font-medium text-sm" x-text="user.phone || '—'"></p>
                </div>
                <div class="p-3 bg-gray-50 dark:bg-gray-800/50 rounded-lg">
                    <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">Date of Birth</p>
                    <p class="text-gray-900 dark:text-white font-medium text-sm" x-text="user.dateOfBirth || '—'"></p>
                </div>
                <div class="p-3 bg-gray-50 dark:bg-gray-800/50 rounded-lg">
                    <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">Gender</p>
                    <p class="text-gray-900 dark:text-white font-medium text-sm capitalize" x-text="user.gender || '—'"></p>
                </div>
                <div class="p-3 bg-gray-50 dark:bg-gray-800/50 rounded-lg">
                    <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">Blood Group</p>
                    <p class="text-gray-900 dark:text-white font-medium text-sm" x-text="user.bloodGroup || '—'"></p>
                </div>
                <div class="p-3 bg-gray-50 dark:bg-gray-800/50 rounded-lg">
                    <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">Emergency Contact</p>
                    <p class="text-gray-900 dark:text-white font-medium text-sm" x-text="user.emergencyContact || '—'"></p>
                </div>
            </div>
        </div>
    </div>

    <!-- Bio Section -->
    <div class="glass-card rounded-xl shadow-md p-6">
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            About Me
        </h3>
        <p class="text-gray-700 dark:text-gray-300 leading-relaxed" x-text="user.bio || 'No bio added yet. Click Edit Profile to add a professional description about yourself.'"></p>
    </div>

    <!-- Professional Information -->
    <div class="glass-card rounded-xl shadow-md p-6">
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            Professional Information
        </h3>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
            <div class="p-3 bg-gradient-to-br from-green-50 to-green-100 dark:from-green-900/20 dark:to-green-800/20 rounded-lg border border-green-200 dark:border-green-800">
                <p class="text-xs text-green-600 dark:text-green-400 mb-1">Department</p>
                <p class="text-gray-900 dark:text-white font-semibold" x-text="user.department || '—'"></p>
            </div>
            <div class="p-3 bg-gradient-to-br from-blue-50 to-blue-100 dark:from-blue-900/20 dark:to-blue-800/20 rounded-lg border border-blue-200 dark:border-blue-800">
                <p class="text-xs text-blue-600 dark:text-blue-400 mb-1">Designation</p>
                <p class="text-gray-900 dark:text-white font-semibold" x-text="user.designation || '—'"></p>
            </div>
            <div class="p-3 bg-gradient-to-br from-purple-50 to-purple-100 dark:from-purple-900/20 dark:to-purple-800/20 rounded-lg border border-purple-200 dark:border-purple-800">
                <p class="text-xs text-purple-600 dark:text-purple-400 mb-1">Qualification</p>
                <p class="text-gray-900 dark:text-white font-semibold" x-text="user.qualification || '—'"></p>
            </div>
            <div class="p-3 bg-gradient-to-br from-orange-50 to-orange-100 dark:from-orange-900/20 dark:to-orange-800/20 rounded-lg border border-orange-200 dark:border-orange-800">
                <p class="text-xs text-orange-600 dark:text-orange-400 mb-1">Experience</p>
                <p class="text-gray-900 dark:text-white font-semibold" x-text="user.experience ? user.experience + ' years' : '—'"></p>
            </div>
            <div class="p-3 bg-gradient-to-br from-teal-50 to-teal-100 dark:from-teal-900/20 dark:to-teal-800/20 rounded-lg border border-teal-200 dark:border-teal-800">
                <p class="text-xs text-teal-600 dark:text-teal-400 mb-1">Joining Date</p>
                <p class="text-gray-900 dark:text-white font-semibold" x-text="user.joiningDate || '—'"></p>
            </div>
        </div>
    </div>

    <!-- Research & Expertise -->
    <div class="glass-card rounded-xl shadow-md p-6">
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
            Research & Expertise Areas
        </h3>
        <div class="flex flex-wrap gap-2">
            <template x-if="user.expertise && user.expertise.length > 0">
                <template x-for="area in user.expertise" :key="area">
                    <span class="px-3 py-1 bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 rounded-full text-sm font-medium" x-text="area"></span>
                </template>
            </template>
            <template x-if="!user.expertise || user.expertise.length === 0">
                <p class="text-gray-500 dark:text-gray-400 text-sm">No expertise areas added yet</p>
            </template>
        </div>
    </div>

    <!-- Assigned Subjects -->
    <div class="glass-card rounded-xl shadow-md p-6">
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
            Assigned Subjects
        </h3>
        <div class="flex flex-wrap gap-2">
            <% if (subjects && subjects.length > 0) { %>
                <% subjects.forEach(function(subject) { %>
                <span class="px-3 py-1 bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-full text-sm font-medium"><%= subject.name %></span>
                <% }); %>
            <% } else { %>
                <p class="text-gray-500 dark:text-gray-400">No subjects assigned</p>
            <% } %>
        </div>
    </div>

    <!-- Address Information -->
    <div class="glass-card rounded-xl shadow-md p-6">
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            Address Information
        </h3>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
            <div class="p-3 bg-gray-50 dark:bg-gray-800/50 rounded-lg">
                <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">House No / Building</p>
                <p class="text-gray-900 dark:text-white font-medium text-sm" x-text="user.houseNo || '—'"></p>
            </div>
            <div class="p-3 bg-gray-50 dark:bg-gray-800/50 rounded-lg">
                <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">Street / Locality</p>
                <p class="text-gray-900 dark:text-white font-medium text-sm" x-text="user.street || '—'"></p>
            </div>
            <div class="p-3 bg-gray-50 dark:bg-gray-800/50 rounded-lg">
                <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">City</p>
                <p class="text-gray-900 dark:text-white font-medium text-sm" x-text="user.city || '—'"></p>
            </div>
            <div class="p-3 bg-gray-50 dark:bg-gray-800/50 rounded-lg">
                <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">District</p>
                <p class="text-gray-900 dark:text-white font-medium text-sm" x-text="user.district || '—'"></p>
            </div>
            <div class="p-3 bg-gray-50 dark:bg-gray-800/50 rounded-lg">
                <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">State</p>
                <p class="text-gray-900 dark:text-white font-medium text-sm" x-text="user.state || '—'"></p>
            </div>
            <div class="p-3 bg-gray-50 dark:bg-gray-800/50 rounded-lg">
                <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">PIN Code</p>
                <p class="text-gray-900 dark:text-white font-medium text-sm" x-text="user.pinCode || '—'"></p>
            </div>
        </div>
        <div class="mt-4 p-3 bg-gray-50 dark:bg-gray-800/50 rounded-lg">
            <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">Full Address</p>
            <p class="text-gray-900 dark:text-white font-medium text-sm" x-text="user.fullAddress || user.address || '—'"></p>
        </div>
    </div>

    <!-- Documents Cloud Storage -->
    <div class="glass-card rounded-xl shadow-md p-6" x-data="documentManager()">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white flex items-center gap-2">
                <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                My Documents
            </h3>
            <button @click="showUploadModal = true" class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 text-sm font-medium transition flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
                Upload
            </button>
        </div>

        <!-- Loading -->
        <div x-show="loading" class="text-center py-8">
            <svg class="animate-spin h-8 w-8 mx-auto text-green-600" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
            </svg>
        </div>

        <!-- Empty State -->
        <div x-show="!loading && categories.length === 0" class="text-center py-12 bg-gray-50 dark:bg-gray-800/50 rounded-xl border-2 border-dashed border-gray-300 dark:border-gray-600">
            <svg class="w-16 h-16 mx-auto text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            <h4 class="text-lg font-medium text-gray-900 dark:text-white mt-4">No Documents</h4>
            <p class="text-gray-500 mt-1">Upload your qualifications, certificates, and ID proofs</p>
        </div>

        <!-- Documents List -->
        <div x-show="!loading && categories.length > 0" class="space-y-4">
            <template x-for="cat in categories" :key="cat.category">
                <details class="bg-gray-50 dark:bg-gray-800/50 rounded-xl overflow-hidden" open>
                    <summary class="px-4 py-3 cursor-pointer hover:bg-gray-100 dark:hover:bg-gray-700/50 flex items-center justify-between">
                        <span class="font-medium text-gray-900 dark:text-white" x-text="cat.categoryLabel"></span>
                        <span class="text-xs bg-green-100 dark:bg-green-900/30 text-green-700 px-2 py-1 rounded-full" x-text="cat.documents.length + ' files'"></span>
                    </summary>
                    <div class="px-4 pb-4 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
                        <template x-for="doc in cat.documents" :key="doc.id">
                            <div class="p-3 bg-white dark:bg-gray-700 rounded-lg border border-gray-200 dark:border-gray-600 flex items-center gap-3">
                                <div class="w-10 h-10 rounded-lg flex items-center justify-center" :class="doc.mimeType.includes('pdf') ? 'bg-red-100 dark:bg-red-900/30' : 'bg-green-100 dark:bg-green-900/30'">
                                    <svg x-show="doc.mimeType.includes('pdf')" class="w-5 h-5 text-red-600" fill="currentColor" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8l-6-6z"/></svg>
                                    <svg x-show="!doc.mimeType.includes('pdf')" class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-medium text-gray-900 dark:text-white truncate" x-text="doc.fileName"></p>
                                    <p class="text-xs text-gray-500" x-text="doc.documentTypeLabel + ' • ' + formatSize(doc.fileSize)"></p>
                                </div>
                                <div class="flex items-center gap-1">
                                    <a :href="doc.viewUrl" target="_blank" class="p-2 text-gray-500 hover:text-green-600 hover:bg-green-50 dark:hover:bg-green-900/30 rounded-lg" title="View">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                                    </a>
                                    <a :href="doc.downloadUrl" download class="p-2 text-gray-500 hover:text-blue-600 hover:bg-blue-50 dark:hover:bg-blue-900/30 rounded-lg" title="Download">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                                    </a>
                                    <button @click="deleteDocument(doc.id)" class="p-2 text-gray-500 hover:text-red-600 hover:bg-red-50 dark:hover:bg-red-900/30 rounded-lg" title="Delete">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                    </button>
                                </div>
                            </div>
                        </template>
                    </div>
                </details>
            </template>
        </div>

        <!-- Upload Modal -->
        <template x-teleport="body">
            <div x-show="showUploadModal" x-cloak class="fixed inset-0 bg-black/50 backdrop-blur-sm z-[9999] overflow-y-auto" @click.self="showUploadModal = false">
                <div class="min-h-screen flex items-center justify-center p-4">
                    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-2xl w-full max-w-lg my-8">
                        <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700 flex items-center justify-between">
                            <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Upload Document</h3>
                            <button @click="showUploadModal = false" class="p-2 text-gray-400 hover:text-gray-600">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                            </button>
                        </div>
                        <form @submit.prevent="uploadDocument()" class="p-6 space-y-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Category *</label>
                                <select x-model="uploadData.category" required class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 dark:bg-gray-700 dark:text-white">
                                    <option value="">Select category</option>
                                    <option value="qualification">Qualifications</option>
                                    <option value="experience">Experience</option>
                                    <option value="id_proof">ID Proof</option>
                                    <option value="certificate">Certificates</option>
                                    <option value="other">Other</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Document Type *</label>
                                <select x-model="uploadData.documentType" required class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 dark:bg-gray-700 dark:text-white">
                                    <option value="">Select type</option>
                                    <option value="degree">Degree</option>
                                    <option value="diploma">Diploma</option>
                                    <option value="certificate">Certificate</option>
                                    <option value="experience_letter">Experience Letter</option>
                                    <option value="offer_letter">Offer Letter</option>
                                    <option value="relieving_letter">Relieving Letter</option>
                                    <option value="aadhar">Aadhar Card</option>
                                    <option value="pan">PAN Card</option>
                                    <option value="other">Other</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Description</label>
                                <input type="text" x-model="uploadData.description" placeholder="e.g., M.Tech Degree 2018" class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 dark:bg-gray-700 dark:text-white">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">File *</label>
                                <div class="border-2 border-dashed border-gray-300 dark:border-gray-600 rounded-xl p-6 text-center hover:border-green-500 cursor-pointer" @click="$refs.fileInput.click()" @dragover.prevent="isDragging = true" @dragleave="isDragging = false" @drop.prevent="handleDrop($event)" :class="{'border-green-500 bg-green-50 dark:bg-green-900/20': isDragging}">
                                    <input type="file" x-ref="fileInput" @change="handleFileSelect($event)" accept=".pdf,.jpg,.jpeg,.png,.webp" class="hidden">
                                    <svg class="w-12 h-12 mx-auto text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg>
                                    <p class="mt-2 text-sm text-gray-600 dark:text-gray-400" x-text="selectedFile ? selectedFile.name : 'Drag & drop or click'"></p>
                                    <p class="text-xs text-gray-500 mt-1">PDF, JPG, PNG, WEBP (Max 10MB)</p>
                                </div>
                            </div>
                            <div class="flex justify-end gap-3 pt-4">
                                <button type="button" @click="showUploadModal = false" class="px-4 py-2 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg">Cancel</button>
                                <button type="submit" :disabled="uploading" class="px-6 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 disabled:opacity-50">
                                    <span x-text="uploading ? 'Uploading...' : 'Upload'"></span>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </template>
    </div>
</div>

<script>
function documentManager() {
    return {
        loading: true,
        categories: [],
        showUploadModal: false,
        uploading: false,
        selectedFile: null,
        isDragging: false,
        uploadData: { category: '', documentType: '', description: '' },
        
        init() { this.loadDocuments(); },
        
        async loadDocuments() {
            this.loading = true;
            try {
                const res = await fetch('/api/documents/my', { credentials: 'include' });
                const data = await res.json();
                this.categories = data.categories || [];
            } catch (err) { console.error('Error:', err); }
            this.loading = false;
        },
        
        handleFileSelect(event) { this.selectedFile = event.target.files[0]; },
        handleDrop(event) { this.isDragging = false; if (event.dataTransfer.files.length) this.selectedFile = event.dataTransfer.files[0]; },
        
        async uploadDocument() {
            if (!this.selectedFile || !this.uploadData.category || !this.uploadData.documentType) { alert('Please fill all required fields'); return; }
            this.uploading = true;
            const formData = new FormData();
            formData.append('file', this.selectedFile);
            formData.append('category', this.uploadData.category);
            formData.append('documentType', this.uploadData.documentType);
            if (this.uploadData.description) formData.append('description', this.uploadData.description);
            
            try {
                const res = await fetch('/api/documents/upload', { method: 'POST', body: formData, credentials: 'include' });
                if (res.ok) { this.showUploadModal = false; this.selectedFile = null; this.uploadData = { category: '', documentType: '', description: '' }; await this.loadDocuments(); }
                else { const err = await res.json(); alert('Upload failed: ' + (err.message || 'Error')); }
            } catch (err) { alert('Upload failed'); }
            this.uploading = false;
        },
        
        async deleteDocument(id) {
            if (!confirm('Delete this document?')) return;
            try {
                const res = await fetch(`/api/documents/${id}`, { method: 'DELETE', credentials: 'include' });
                if (res.ok) await this.loadDocuments(); else alert('Delete failed');
            } catch (err) { console.error(err); }
        },
        
        formatSize(bytes) {
            if (bytes < 1024) return bytes + ' B';
            if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
            return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
        }
    };
}
</script>
