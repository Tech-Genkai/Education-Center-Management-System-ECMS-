<!-- Teacher Dashboard Overview Tab -->
<div class="space-y-6">
    <!-- Welcome Banner -->
    <div class="glass-card rounded-2xl p-6 bg-gradient-to-r from-green-600 to-teal-600 text-white">
        <div class="flex items-center justify-between">
            <div>
                <h2 class="text-2xl font-bold">Welcome back, <span x-text="user.name"></span>! 👋</h2>
                <p class="text-green-100 mt-1">Manage your classes and track student progress.</p>
            </div>
        </div>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="glass-card rounded-xl shadow-md p-6 border-l-4 border-blue-500">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-600 dark:text-gray-400">Total Students</p>
                    <p class="text-3xl font-bold text-gray-900 dark:text-white mt-2" x-text="stats.totalStudents"></p>
                </div>
                <div class="p-3 bg-blue-100 dark:bg-blue-900/30 rounded-lg">
                    <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
                    </svg>
                </div>
            </div>
        </div>

        <div class="glass-card rounded-xl shadow-md p-6 border-l-4 border-green-500">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-600 dark:text-gray-400">Active Classes</p>
                    <p class="text-3xl font-bold text-gray-900 dark:text-white mt-2" x-text="stats.activeClasses"></p>
                </div>
                <div class="p-3 bg-green-100 dark:bg-green-900/30 rounded-lg">
                    <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                    </svg>
                </div>
            </div>
        </div>

        <div class="glass-card rounded-xl shadow-md p-6 border-l-4 border-yellow-500">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-600 dark:text-gray-400">Pending Submissions</p>
                    <p class="text-3xl font-bold text-gray-900 dark:text-white mt-2" x-text="stats.pendingSubmissions"></p>
                </div>
                <div class="p-3 bg-yellow-100 dark:bg-yellow-900/30 rounded-lg">
                    <svg class="w-8 h-8 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
            </div>
        </div>

        <div class="glass-card rounded-xl shadow-md p-6 border-l-4 border-purple-500">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-600 dark:text-gray-400">Avg. Attendance</p>
                    <p class="text-3xl font-bold text-gray-900 dark:text-white mt-2"><span x-text="stats.avgAttendance"></span>%</p>
                </div>
                <div class="p-3 bg-purple-100 dark:bg-purple-900/30 rounded-lg">
                    <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- My Classes -->
        <div class="lg:col-span-2 glass-card rounded-xl shadow-md p-6">
            <div class="flex items-center justify-between mb-6">
                <h3 class="text-lg font-bold text-gray-900 dark:text-white">My Classes</h3>
                <button @click="setTab('classes')" class="text-sm text-green-600 dark:text-green-400 hover:underline">View All</button>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <% if (classes && classes.length > 0) { %>
                    <% classes.slice(0, 4).forEach(function(classItem) { %>
                    <div class="border border-gray-200 dark:border-gray-700 rounded-lg p-4 hover:shadow-md transition bg-white dark:bg-gray-700">
                        <div class="flex items-center justify-between mb-2">
                            <h4 class="font-semibold text-gray-900 dark:text-white"><%= classItem.name %></h4>
                            <span class="text-xs px-2 py-1 bg-<%= classItem.color %>-100 dark:bg-<%= classItem.color %>-900/30 text-<%= classItem.color %>-700 dark:text-<%= classItem.color %>-300 rounded-full"><%= classItem.section %></span>
                        </div>
                        <p class="text-sm text-gray-600 dark:text-gray-400 mb-3"><%= classItem.subject %></p>
                        <div class="flex items-center justify-between text-sm">
                            <span class="text-gray-500 dark:text-gray-400"><%= classItem.students %> students</span>
                            <button class="text-green-600 dark:text-green-400 hover:underline font-medium">Manage →</button>
                        </div>
                    </div>
                    <% }); %>
                <% } else { %>
                    <p class="col-span-2 text-center text-gray-500 dark:text-gray-400 py-8">No classes assigned</p>
                <% } %>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="glass-card rounded-xl shadow-md p-6">
            <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-4">Quick Actions</h3>
            <div class="space-y-3">
                <button @click="setTab('attendance')" class="w-full flex items-center px-4 py-3 bg-green-50 dark:bg-green-900/30 text-green-700 dark:text-green-300 rounded-lg hover:bg-green-100 dark:hover:bg-green-900/50 transition">
                    <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
                    </svg>
                    <span class="font-medium text-sm">Mark Attendance</span>
                </button>
                <button @click="setTab('assignments')" class="w-full flex items-center px-4 py-3 bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-lg hover:bg-blue-100 dark:hover:bg-blue-900/50 transition">
                    <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                    </svg>
                    <span class="font-medium text-sm">Create Assignment</span>
                </button>
                <button @click="setTab('submissions')" class="w-full flex items-center px-4 py-3 bg-purple-50 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 rounded-lg hover:bg-purple-100 dark:hover:bg-purple-900/50 transition">
                    <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                    </svg>
                    <span class="font-medium text-sm">Grade Submissions</span>
                </button>
                <button @click="setTab('schedule')" class="w-full flex items-center px-4 py-3 bg-yellow-50 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-300 rounded-lg hover:bg-yellow-100 dark:hover:bg-yellow-900/50 transition">
                    <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                    <span class="font-medium text-sm">View Schedule</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Today's Schedule & Top Performers -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Today's Schedule -->
        <div class="glass-card rounded-xl shadow-md p-6">
            <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-4">Today's Schedule</h3>
            <div class="space-y-3">
                <% if (schedule && schedule.length > 0) { %>
                    <% schedule.forEach(function(item) { %>
                    <div class="flex items-start p-3 bg-<%= item.color %>-50 dark:bg-<%= item.color %>-900/20 rounded-lg">
                        <div class="flex-shrink-0 mt-1 mr-3">
                            <div class="w-2 h-2 bg-<%= item.color %>-500 rounded-full"></div>
                        </div>
                        <div class="flex-1">
                            <p class="text-sm font-semibold text-gray-900 dark:text-white"><%= item.subject %></p>
                            <p class="text-xs text-gray-600 dark:text-gray-400"><%= item.time %></p>
                            <p class="text-xs text-gray-500 dark:text-gray-500"><%= item.class %> - <%= item.room %></p>
                        </div>
                    </div>
                    <% }); %>
                <% } else { %>
                    <p class="text-center text-gray-500 dark:text-gray-400 py-4">No classes scheduled today</p>
                <% } %>
            </div>
        </div>

        <!-- Top Performers -->
        <div class="glass-card rounded-xl shadow-md p-6">
            <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-4">Top Performers</h3>
            <div class="space-y-3">
                <% if (topPerformers && topPerformers.length > 0) { %>
                    <% topPerformers.forEach(function(student, index) { %>
                    <div class="flex items-center space-x-3">
                        <div class="flex-shrink-0 w-8 h-8 bg-<%= student.color %>-100 dark:bg-<%= student.color %>-900/30 rounded-full flex items-center justify-center">
                            <span class="text-sm font-bold text-<%= student.color %>-700 dark:text-<%= student.color %>-300"><%= index + 1 %></span>
                        </div>
                        <div class="flex-1">
                            <p class="text-sm font-medium text-gray-900 dark:text-white"><%= student.name %></p>
                            <p class="text-xs text-gray-500 dark:text-gray-400"><%= student.class %></p>
                        </div>
                        <span class="text-sm font-semibold text-gray-900 dark:text-white"><%= student.grade %>%</span>
                    </div>
                    <% }); %>
                <% } else { %>
                    <p class="text-center text-gray-500 dark:text-gray-400 py-4">No data available</p>
                <% } %>
            </div>
        </div>
    </div>
</div>
