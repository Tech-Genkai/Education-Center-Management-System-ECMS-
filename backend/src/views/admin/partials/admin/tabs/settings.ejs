    <div class="glass-card rounded-xl shadow-md p-6">
        <p class="text-gray-600 dark:text-gray-400">Settings functionality coming soon...</p>
    </div>

    <!-- Account Section -->
    <div class="glass-card rounded-xl shadow-md p-6 mt-6">
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4 text-3d">Account</h3>
        <div class="border-t border-gray-200 dark:border-gray-700 pt-4">
