<!-- Profile Tab Content -->
<div class="max-w-6xl mx-auto">
    <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white">My Profile</h2>
        <button id="editProfileBtn" type="button" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 shadow-sm">
            Edit Profile
        </button>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Profile Picture Section -->
        <div class="lg:col-span-1">
            <div class="glass-card rounded-xl shadow-md p-6">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Profile Picture</h3>
                <div class="flex flex-col items-center">
                    <div class="relative mb-4">
                        <img id="profilePicturePreview" src="<%= user.profilePicture || '/static/images/profile/default/default-profile.png' %>" alt="Profile" class="w-40 h-40 rounded-full object-cover border-4 border-gray-200 dark:border-gray-600">
                        <div id="uploadSpinner" class="hidden absolute inset-0 bg-gray-900 bg-opacity-50 rounded-full flex items-center justify-center">
                            <svg class="animate-spin h-8 w-8 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                        </div>
                        <button type="button" onclick="document.getElementById('profilePictureInput').click()" class="absolute bottom-0 right-0 bg-blue-600 hover:bg-blue-700 text-white rounded-full p-3 shadow-lg transition-all hover:scale-110">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
                            </svg>
                        </button>
                        <input type="file" id="profilePictureInput" accept="image/jpeg,image/png,image/webp" class="hidden" onchange="handleProfilePictureChange(event)">
                    </div>
                    <p class="text-sm text-gray-600 dark:text-gray-400 text-center mb-2"><%= user.name %></p>
                    <p class="text-xs text-gray-500 dark:text-gray-500 text-center"><%= user.email %></p>
                    <div id="uploadControls" class="hidden mt-4 space-y-2 w-full">
                        <button type="button" onclick="uploadProfilePicture()" id="uploadBtn" class="w-full px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 text-sm transition-colors">
                            <span class="flex items-center justify-center">
                                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
                                </svg>
                                Upload Photo
                            </span>
                        </button>
                        <button type="button" onclick="cancelProfilePictureUpload()" class="w-full px-4 py-2 bg-gray-300 dark:bg-gray-600 text-gray-700 dark:text-gray-200 rounded-lg hover:bg-gray-400 dark:hover:bg-gray-500 text-sm transition-colors">
                            Cancel
                        </button>
                    </div>
                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-2 text-center">JPG, PNG or WEBP (Max 2MB)</p>
                </div>
            </div>

            <!-- Quick Info -->
            <div class="glass-card rounded-xl shadow-md p-6 mt-6">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Quick Info</h3>
                <div class="space-y-3">
                    <div class="flex items-center text-sm">
                        <svg class="w-5 h-5 text-gray-500 dark:text-gray-400 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                        </svg>
                        <span class="text-gray-700 dark:text-gray-300"><%= user.designation %></span>
                    </div>
                    <div class="flex items-center text-sm">
                        <svg class="w-5 h-5 text-gray-500 dark:text-gray-400 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                        </svg>
                        <span class="text-gray-700 dark:text-gray-300"><%= user.department %></span>
                    </div>
                    <div class="flex items-center text-sm">
                        <svg class="w-5 h-5 text-gray-500 dark:text-gray-400 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                        </svg>
                        <span class="text-gray-700 dark:text-gray-300 uppercase"><%= user.accessLevel %> Access</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Profile Form Section -->
        <div class="lg:col-span-2">
            <div class="glass-card rounded-xl shadow-md p-6">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-6">Personal Information</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm">
                    <div>
                        <p class="text-gray-500 dark:text-gray-400">First Name</p>
                        <p class="text-gray-900 dark:text-white font-medium"><%= user.firstName || '—' %></p>
                    </div>
                    <div>
                        <p class="text-gray-500 dark:text-gray-400">Last Name</p>
                        <p class="text-gray-900 dark:text-white font-medium"><%= user.lastName || '—' %></p>
                    </div>
                    <div>
                        <p class="text-gray-500 dark:text-gray-400">Email</p>
                        <p class="text-gray-900 dark:text-white font-medium"><%= user.email %></p>
                    </div>
                    <div>
                        <p class="text-gray-500 dark:text-gray-400">Phone</p>
                        <p class="text-gray-900 dark:text-white font-medium"><%= user.phone || '—' %></p>
                    </div>
                    <div>
                        <p class="text-gray-500 dark:text-gray-400">Date of Birth</p>
                        <p class="text-gray-900 dark:text-white font-medium"><%= user.dateOfBirth || '—' %></p>
                    </div>
                    <div>
                        <p class="text-gray-500 dark:text-gray-400">Gender</p>
                        <p class="text-gray-900 dark:text-white font-medium capitalize"><%= user.gender || '—' %></p>
                    </div>
                    <div>
                        <p class="text-gray-500 dark:text-gray-400">Designation</p>
                        <p class="text-gray-900 dark:text-white font-medium"><%= user.designation || '—' %></p>
                    </div>
                    <div>
                        <p class="text-gray-500 dark:text-gray-400">Department</p>
                        <p class="text-gray-900 dark:text-white font-medium"><%= user.department || '—' %></p>
                    </div>
                    <div class="md:col-span-2">
                        <p class="text-gray-500 dark:text-gray-400">Address</p>
                        <% 
                          const addr = user.addressParts || {}; 
                          const addrParts = [];
                          const line1 = [addr.houseNo, addr.buildingName].filter(Boolean).join(' ').trim();
                          if (line1) addrParts.push(line1);
                          if (addr.street) addrParts.push(addr.street);
                          if (addr.city) addrParts.push(addr.city);
                          if (addr.district) addrParts.push(addr.district);
                          if (addr.state) addrParts.push(addr.state);
                          if (addr.country) addrParts.push(addr.country);
                          if (addr.pinCode) addrParts.push(addr.pinCode);
                          else if (addr.zipCode) addrParts.push(addr.zipCode);
                          if (addr.landmark) addrParts.push(`Landmark: ${addr.landmark}`);
                          const combinedAddress = addrParts.filter(Boolean).join(', ') || (user.address || '').trim();
                        %>
                        <p class="text-gray-900 dark:text-white font-medium"><%= combinedAddress || '—' %></p>
                    </div>
                    <div>
                        <p class="text-gray-500 dark:text-gray-400">Blood Group</p>
                        <p class="text-gray-900 dark:text-white font-medium"><%= user.bloodGroup || '—' %></p>
                    </div>
                    <div>
                        <p class="text-gray-500 dark:text-gray-400">Emergency Contact</p>
                        <p class="text-gray-900 dark:text-white font-medium"><%= user.emergencyContact || '—' %></p>
                    </div>
                </div>
            </div>

            <!-- My Documents -->
            <div class="glass-card rounded-xl shadow-md p-6 mt-6" x-data="documentManager()">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-white flex items-center gap-2">
                        <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                        My Documents
                    </h3>
                    <button @click="showUploadModal = true" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 text-sm font-medium transition flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
                        Upload
                    </button>
                </div>

                <!-- Loading -->
                <div x-show="loading" class="text-center py-8">
                    <svg class="animate-spin h-8 w-8 mx-auto text-blue-600" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                    </svg>
                </div>

                <!-- Empty State -->
                <div x-show="!loading && categories.length === 0" class="text-center py-8 bg-gray-50 dark:bg-gray-800/50 rounded-xl border-2 border-dashed border-gray-300 dark:border-gray-600">
                    <svg class="w-12 h-12 mx-auto text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                    <h4 class="font-medium text-gray-900 dark:text-white mt-3">No Documents</h4>
                    <p class="text-gray-500 text-sm mt-1">Upload your certificates, ID proofs, and other documents</p>
                </div>

                <!-- Documents List -->
                <div x-show="!loading && categories.length > 0" class="space-y-3">
                    <template x-for="cat in categories" :key="cat.category">
                        <details class="bg-gray-50 dark:bg-gray-800/50 rounded-lg overflow-hidden" open>
                            <summary class="px-4 py-3 cursor-pointer hover:bg-gray-100 dark:hover:bg-gray-700/50 flex items-center justify-between">
                                <span class="font-medium text-gray-900 dark:text-white" x-text="cat.categoryLabel"></span>
                                <span class="text-xs bg-blue-100 dark:bg-blue-900/30 text-blue-700 px-2 py-1 rounded-full" x-text="cat.documents.length + ' files'"></span>
                            </summary>
                            <div class="px-4 pb-4 space-y-2">
                                <template x-for="doc in cat.documents" :key="doc.id">
                                    <div class="p-2 bg-white dark:bg-gray-700 rounded-lg border border-gray-200 dark:border-gray-600 flex items-center gap-3">
                                        <div class="w-8 h-8 rounded flex items-center justify-center" :class="doc.mimeType.includes('pdf') ? 'bg-red-100' : 'bg-blue-100'">
                                            <svg x-show="doc.mimeType.includes('pdf')" class="w-4 h-4 text-red-600" fill="currentColor" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8l-6-6z"/></svg>
                                            <svg x-show="!doc.mimeType.includes('pdf')" class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <p class="text-sm font-medium text-gray-900 dark:text-white truncate" x-text="doc.fileName"></p>
                                            <p class="text-xs text-gray-500" x-text="doc.documentTypeLabel + ' • ' + formatSize(doc.fileSize)"></p>
                                        </div>
                                        <div class="flex items-center gap-1">
                                            <a :href="doc.viewUrl" target="_blank" class="p-1.5 text-gray-500 hover:text-blue-600 rounded" title="View">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                                            </a>
                                            <a :href="doc.downloadUrl" download class="p-1.5 text-gray-500 hover:text-green-600 rounded" title="Download">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                                            </a>
                                            <button @click="deleteDocument(doc.id)" class="p-1.5 text-gray-500 hover:text-red-600 rounded" title="Delete">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                            </button>
                                        </div>
                                    </div>
                                </template>
                            </div>
                        </details>
                    </template>
                </div>

                <!-- Upload Modal -->
                <template x-teleport="body">
                    <div x-show="showUploadModal" x-cloak class="fixed inset-0 bg-black/50 backdrop-blur-sm z-[9999] overflow-y-auto" @click.self="showUploadModal = false">
                        <div class="min-h-screen flex items-center justify-center p-4">
                            <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-2xl w-full max-w-lg my-8">
                                <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700 flex items-center justify-between">
                                    <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Upload Document</h3>
                                    <button @click="showUploadModal = false" class="p-2 text-gray-400 hover:text-gray-600">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                                    </button>
                                </div>
                                <form @submit.prevent="uploadDocument()" class="p-6 space-y-4">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Category *</label>
                                        <select x-model="uploadData.category" required class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg dark:bg-gray-700 dark:text-white">
                                            <option value="">Select category</option>
                                            <option value="qualification">Qualifications</option>
                                            <option value="id_proof">ID Proof</option>
                                            <option value="certificate">Certificates</option>
                                            <option value="other">Other</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Document Type *</label>
                                        <select x-model="uploadData.documentType" required class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg dark:bg-gray-700 dark:text-white">
                                            <option value="">Select type</option>
                                            <option value="degree">Degree</option>
                                            <option value="certificate">Certificate</option>
                                            <option value="aadhar">Aadhar Card</option>
                                            <option value="pan">PAN Card</option>
                                            <option value="other">Other</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Description</label>
                                        <input type="text" x-model="uploadData.description" placeholder="e.g., MBA Certificate 2020" class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg dark:bg-gray-700 dark:text-white">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">File *</label>
                                        <div class="border-2 border-dashed border-gray-300 dark:border-gray-600 rounded-xl p-6 text-center hover:border-blue-500 cursor-pointer" @click="$refs.fileInput.click()" @dragover.prevent="isDragging = true" @dragleave="isDragging = false" @drop.prevent="handleDrop($event)" :class="{'border-blue-500 bg-blue-50': isDragging}">
                                            <input type="file" x-ref="fileInput" @change="handleFileSelect($event)" accept=".pdf,.jpg,.jpeg,.png,.webp" class="hidden">
                                            <svg class="w-10 h-10 mx-auto text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg>
                                            <p class="mt-2 text-sm text-gray-600 dark:text-gray-400" x-text="selectedFile ? selectedFile.name : 'Drag & drop or click'"></p>
                                            <p class="text-xs text-gray-500 mt-1">PDF, JPG, PNG, WEBP (Max 10MB)</p>
                                        </div>
                                    </div>
                                    <div class="flex justify-end gap-3 pt-4">
                                        <button type="button" @click="showUploadModal = false" class="px-4 py-2 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg">Cancel</button>
                                        <button type="submit" :disabled="uploading" class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 disabled:opacity-50">
                                            <span x-text="uploading ? 'Uploading...' : 'Upload'"></span>
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </template>
            </div>
        </div>
    </div>
</div>

<script>
function documentManager() {
    return {
        loading: true,
        categories: [],
        showUploadModal: false,
        uploading: false,
        selectedFile: null,
        isDragging: false,
        uploadData: { category: '', documentType: '', description: '' },
        
        init() { this.loadDocuments(); },
        
        async loadDocuments() {
            this.loading = true;
            try {
                const res = await fetch('/api/documents/my', { credentials: 'include' });
                const data = await res.json();
                this.categories = data.categories || [];
            } catch (err) { console.error('Error:', err); }
            this.loading = false;
        },
        
        handleFileSelect(event) { this.selectedFile = event.target.files[0]; },
        handleDrop(event) { this.isDragging = false; if (event.dataTransfer.files.length) this.selectedFile = event.dataTransfer.files[0]; },
        
        async uploadDocument() {
            if (!this.selectedFile || !this.uploadData.category || !this.uploadData.documentType) { alert('Please fill required fields'); return; }
            this.uploading = true;
            const formData = new FormData();
            formData.append('file', this.selectedFile);
            formData.append('category', this.uploadData.category);
            formData.append('documentType', this.uploadData.documentType);
            if (this.uploadData.description) formData.append('description', this.uploadData.description);
            
            try {
                const res = await fetch('/api/documents/upload', { method: 'POST', body: formData, credentials: 'include' });
                if (res.ok) { this.showUploadModal = false; this.selectedFile = null; this.uploadData = { category: '', documentType: '', description: '' }; await this.loadDocuments(); }
                else { const err = await res.json(); alert('Upload failed: ' + (err.message || 'Error')); }
            } catch (err) { alert('Upload failed'); }
            this.uploading = false;
        },
        
        async deleteDocument(id) {
            if (!confirm('Delete this document?')) return;
            try {
                const res = await fetch(`/api/documents/${id}`, { method: 'DELETE', credentials: 'include' });
                if (res.ok) await this.loadDocuments(); else alert('Delete failed');
            } catch (err) { console.error(err); }
        },
        
        formatSize(bytes) {
            if (bytes < 1024) return bytes + ' B';
            if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
            return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
        }
    };
}
</script>
