<script>
// ========================================
// NEW FEATURES HANDLERS - Attendance, Fees, Marks, Assignments
// ========================================

// Global state for pagination
let attendancePage = 1;
let feesPage = 1;
let marksPage = 1;
let assignmentsPage = 1;
const pageLimit = 10;

// ========================================
// ATTENDANCE HANDLERS
// ========================================

// --- Attendance Handlers (Refactored for Course/Semester) ---

// Populate Dropdowns logic (shared if possible, but keeping separate for safety unless generalized)
async function populateAttendanceDropdowns() {
    try {
        const courseSelect = document.getElementById('attendanceCourseSelect');
        if (courseSelect) {
            const res = await fetch('/api/courses');
            const data = await res.json();
            if (data.courses) {
                courseSelect.innerHTML = '<option value="">Select Course</option>';
                data.courses.forEach(c => {
                    const opt = document.createElement('option');
                    opt.value = c._id;
                    opt.dataset.code = c.courseCode;
                    opt.textContent = `${c.courseName} (${c.courseCode})`;
                    courseSelect.appendChild(opt);
                });
            }
        }
    } catch (e) { console.error('Error loading attendance courses', e); }
}

let selectedCourseCodeForAttendance = null;

window.onAttendanceCourseChange = async function(courseId) {
    const select = document.getElementById('attendanceCourseSelect');
    const courseCode = select.options[select.selectedIndex]?.dataset.code;
    selectedCourseCodeForAttendance = courseCode;
    
    // Reset subjects
    const subSelect = document.getElementById('attendanceSubjectSelect');
    subSelect.innerHTML = '<option value="">Select Subject</option>';
    
    const semester = document.getElementById('attendanceSemesterSelect').value;
    if (courseCode && semester) {
        await loadSubjectsForAttendance(courseCode, semester);
    }
}

window.onAttendanceSemesterChange = async function(semester) {
    if (selectedCourseCodeForAttendance && semester) {
        await loadSubjectsForAttendance(selectedCourseCodeForAttendance, semester);
    }
}

async function loadSubjectsForAttendance(branch, semester) {
    try {
        const res = await fetch('/api/subjects'); 
        const data = await res.json();
        const subjectSelect = document.getElementById('attendanceSubjectSelect');
        
        if (data.subjects) {
            const filtered = data.subjects.filter(s => 
                (!s.branch || s.branch === branch) && 
                (!s.semester || s.semester == semester)
            );
            
            subjectSelect.innerHTML = '<option value="">Select Subject</option>';
            if (filtered.length === 0) {
                 subjectSelect.innerHTML = '<option value="">No subjects found</option>';
            }
            filtered.forEach(s => {
                const opt = document.createElement('option');
                opt.value = s._id;
                opt.textContent = `${s.subjectName} (${s.subjectCode})`;
                subjectSelect.appendChild(opt);
            });
        }
    } catch (e) { console.error('Error loading attendance subjects', e); }
}

async function loadAttendanceForMarking() {
    const date = document.getElementById('attendance-date').value;
    const courseId = document.getElementById('attendanceCourseSelect').value;
    const semester = document.getElementById('attendanceSemesterSelect').value;
    const subjectId = document.getElementById('attendanceSubjectSelect').value;

    if (!date || !courseId || !semester || !subjectId) {
        showNotification('Please select date, course, semester, and subject', 'error');
        return;
    }

    try {
        // Load students for the selected course and semester
        // We use the new filtering logic in studentController
        const response = await fetch(`/api/students?courseId=${courseId}&semester=${semester}&limit=100`);
        const data = await response.json();
        
        if (data.success) {
            if (data.data.length > 0) {
                displayStudentsForAttendance(data.data);
                document.getElementById('bulk-attendance-list').classList.remove('hidden');
            } else {
                 showNotification('No students found for this Course/Semester', 'info');
                 document.getElementById('bulk-attendance-list').classList.add('hidden');
            }
        }
    } catch (error) {
        console.error('Error loading students:', error);
        showNotification('Failed to load students', 'error');
    }
}

function displayStudentsForAttendance(students) {
    const tableHTML = `
        <table class="w-full">
            <thead class="bg-gray-50 dark:bg-gray-800">
                <tr>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Roll No</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Name</th>
                    <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Present</th>
                    <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Absent</th>
                    <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Late</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                ${students.map(student => `
                    <tr data-student-id="${student._id}">
                        <td class="px-4 py-3 text-sm">${student.rollNumber || '-'}</td>
                        <td class="px-4 py-3 text-sm">${student.firstName} ${student.lastName}</td>
                        <td class="px-4 py-3 text-center">
                            <input type="radio" name="attendance-${student._id}" value="present" class="w-4 h-4 text-green-600" checked>
                        </td>
                        <td class="px-4 py-3 text-center">
                            <input type="radio" name="attendance-${student._id}" value="absent" class="w-4 h-4 text-red-600">
                        </td>
                        <td class="px-4 py-3 text-center">
                            <input type="radio" name="attendance-${student._id}" value="late" class="w-4 h-4 text-yellow-600">
                        </td>
                    </tr>
                `).join('')}
            </tbody>
        </table>
    `;
    document.getElementById('students-attendance-table').innerHTML = tableHTML;
}

function markAllAs(status) {
    const radios = document.querySelectorAll(`input[value="${status}"]`);
    radios.forEach(radio => radio.checked = true);
}

async function submitBulkAttendance() {
    const date = document.getElementById('attendance-date').value;
    const courseId = document.getElementById('attendanceCourseSelect').value;
    const semester = document.getElementById('attendanceSemesterSelect').value;
    const subjectId = document.getElementById('attendanceSubjectSelect').value;

    const rows = document.querySelectorAll('#students-attendance-table tbody tr');
    const records = Array.from(rows).map(row => {
        const studentId = row.dataset.studentId;
        const status = row.querySelector('input[type="radio"]:checked').value;
        return { studentId, status };
    });

    try {
        const response = await fetch('/api/attendance/bulk', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ courseId, semester, subjectId, date, records })
        });

        const data = await response.json();
        if (data.success) {
            showNotification('Attendance marked successfully!', 'success');
            document.getElementById('bulk-attendance-list').classList.add('hidden');
            loadAttendanceRecords();
        } else {
            showNotification(data.message || 'Failed to mark attendance', 'error');
        }
    } catch (error) {
        console.error('Error submitting attendance:', error);
        showNotification('Failed to submit attendance', 'error');
    }
}

async function loadAttendanceRecords() {
    try {
        const response = await fetch(`/api/attendance?page=${attendancePage}&limit=${pageLimit}`);
        const data = await response.json();
        
        if (data.success) {
            displayAttendanceRecords(data.data);
            updateAttendancePagination(data.pagination);
        }
    } catch (error) {
        console.error('Error loading attendance records:', error);
    }
}

function displayAttendanceRecords(records) {
    const tbody = document.getElementById('attendance-table-body');
    if (records.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" class="px-4 py-8 text-center text-gray-500">No records found</td></tr>';
        return;
    }

    tbody.innerHTML = records.map(record => `
        <tr>
            <td class="px-4 py-3 text-sm">${new Date(record.date).toLocaleDateString()}</td>
            <td class="px-4 py-3 text-sm">${record.studentId?.firstName} ${record.studentId?.lastName}</td>
            <td class="px-4 py-3 text-sm">${record.classId?.name || 'N/A'}</td>
            <td class="px-4 py-3 text-sm">${record.subjectId?.name || 'N/A'}</td>
            <td class="px-4 py-3">
                <span class="px-2 py-1 text-xs rounded-full ${getStatusBadgeClass(record.status)}">
                    ${record.status.charAt(0).toUpperCase() + record.status.slice(1)}
                </span>
            </td>
            <td class="px-4 py-3 text-sm">
                <button onclick="editAttendance('${record._id}')" class="text-blue-600 hover:text-blue-800">Edit</button>
            </td>
        </tr>
    `).join('');
}

function getStatusBadgeClass(status) {
    const classes = {
        present: 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400',
        absent: 'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-400',
        late: 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-400',
        excused: 'bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-400'
    };
    return classes[status] || classes.present;
}

function updateAttendancePagination(pagination) {
    document.getElementById('attendance-start').textContent = (pagination.page - 1) * pagination.limit + 1;
    document.getElementById('attendance-end').textContent = Math.min(pagination.page * pagination.limit, pagination.total);
    document.getElementById('attendance-total').textContent = pagination.total;
}

function previousAttendancePage() {
    if (attendancePage > 1) {
        attendancePage--;
        loadAttendanceRecords();
    }
}

function nextAttendancePage() {
    attendancePage++;
    loadAttendanceRecords();
}

