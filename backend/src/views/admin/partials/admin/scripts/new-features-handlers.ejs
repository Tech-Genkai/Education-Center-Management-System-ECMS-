// Populate Marks Dropdowns (Course & Optional Class)
async function populateMarksDropdowns() {
    try {
        // Load Courses
        const courseSelect = document.getElementById('marksCourseSelect');
        if (courseSelect) {
            const res = await fetch('/api/courses');
            const data = await res.json();
            if (data.courses) {
                courseSelect.innerHTML = '<option value="">Select Course</option>';
                data.courses.forEach(c => {
                    const opt = document.createElement('option');
                    opt.value = c._id;
                    opt.dataset.code = c.courseCode;
                    opt.textContent = `${c.courseName} (${c.courseCode})`;
                    courseSelect.appendChild(opt);
                });
            }
        }
        
        // Load Classes (Optional Filter)
        const classSelect = document.getElementById('marksClassSelect');
        if (classSelect) {
            const res = await fetch('/api/classes');
            const data = await res.json();
            if (data.classes) {
                classSelect.innerHTML = '<option value="">All Classes</option>';
                data.classes.forEach(c => {
                    const opt = document.createElement('option');
                    opt.value = c._id;
                    opt.textContent = `${c.className} (${c.classCode})`;
                    classSelect.appendChild(opt);
                });
            }
        }
    } catch (e) { console.error('Error loading marks dropdowns', e); }
}

// Global variable to store selected course code
let selectedCourseCodeForMarks = null;

// Handle Course Change
window.onMarksCourseChange = async function(courseId) {
    const select = document.getElementById('marksCourseSelect');
    const courseCode = select.options[select.selectedIndex]?.dataset.code;
    selectedCourseCodeForMarks = courseCode;
    
    // Reset subjects
    const subSelect = document.getElementById('marksSubjectSelect');
    subSelect.innerHTML = '<option value="">Select Subject</option>';
    
    // If semester is already selected, load subjects
    const semester = document.getElementById('marksSemesterSelect').value;
    if (courseCode && semester) {
        await loadSubjectsForMarks(courseCode, semester);
    }
}

// Handle Semester Change
window.onMarksSemesterChange = async function(semester) {
    if (selectedCourseCodeForMarks && semester) {
        await loadSubjectsForMarks(selectedCourseCodeForMarks, semester);
    }
}

// Load Subjects filtered by Branch (CourseCode) and Semester
async function loadSubjectsForMarks(branch, semester) {
    try {
        const res = await fetch('/api/subjects'); // Ideally pass filters to API: /api/subjects?branch=...&semester=...
        const data = await res.json();
        const subjectSelect = document.getElementById('marksSubjectSelect');
        
        if (data.subjects) {
            // Client-side filter for now
            const filtered = data.subjects.filter(s => 
                (!s.branch || s.branch === branch) && 
                (!s.semester || s.semester == semester)
            );
            
            subjectSelect.innerHTML = '<option value="">Select Subject</option>';
            if (filtered.length === 0) {
                 subjectSelect.innerHTML = '<option value="">No subjects found</option>';
            }
            filtered.forEach(s => {
                const opt = document.createElement('option');
                opt.value = s._id;
                opt.textContent = `${s.subjectName} (${s.subjectCode})`;
                subjectSelect.appendChild(opt);
            });
        }
    } catch (e) { console.error('Error loading subjects', e); }
}

// Load Students (Updated for Course-centric flow)
async function loadMarksEntryStudents() {
    const courseId = document.getElementById('marksCourseSelect').value;
    const subjectId = document.getElementById('marksSubjectSelect').value;
    const classId = document.getElementById('marksClassSelect')?.value; // Optional
    
    if (!courseId) {
        showNotification('Please select a Course', 'error');
        return;
    }
    if (!subjectId) {
        showNotification('Please select a Subject', 'error');
        return;
    }

    try {
        let url = `/api/students?courseId=${courseId}&limit=100`;
        if (classId) url += `&classId=${classId}`;
        
        const response = await fetch(url);
        const data = await response.json();
        
        if (data.success) {
            // Check if students exist
            if (data.data && data.data.length > 0) {
                displayStudentsForMarks(data.data);
                document.getElementById('marks-entry-list').classList.remove('hidden');
            } else {
                 showNotification('No students found for this Course', 'info');
                 document.getElementById('marks-entry-list').classList.add('hidden');
            }
        }
    } catch (error) {
        console.error('Error loading students:', error);
        showNotification('Failed to load students', 'error');
    }
}
