async function loadFees() {
    try {
        const status = document.getElementById('fee-status-filter').value;
        const feeType = document.getElementById('fee-type-filter') ? document.getElementById('fee-type-filter').value : ''; // Assuming ID exists or check fees.ejs
        const courseId = document.getElementById('feesCourseSelect').value;
        const semester = document.getElementById('feesSemesterSelect').value;

        let url = `/api/fees?page=${feesPage}&limit=${pageLimit}`;
        if (status) url += `&status=${status}`;
        if (feeType) url += `&feeType=${feeType}`;
        if (courseId) url += `&courseId=${courseId}`;
        if (semester) url += `&semester=${semester}`;

        const response = await fetch(url);
        const data = await response.json();
        
        if (data.success) {
            displayFees(data.data);
            updateFeesPagination(data.pagination);
        }
    } catch (error) {
        console.error('Error loading fees:', error);
    }
}

function filterFees() {
    feesPage = 1;
    loadFees();
}

function displayFees(fees) {
    const tbody = document.getElementById('fees-table-body');
    if (fees.length === 0) {
        tbody.innerHTML = '<tr><td colspan="8" class="px-4 py-8 text-center text-gray-500">No records found</td></tr>';
        return;
    }

    tbody.innerHTML = fees.map(fee => {
        const balance = fee.amountDue - fee.amountPaid;
        return `
            <tr>
                <td class="px-4 py-3 text-sm">${fee.invoiceNumber || 'N/A'}</td>
                <td class="px-4 py-3 text-sm">${fee.studentId?.firstName} ${fee.studentId?.lastName}</td>
                <td class="px-4 py-3 text-sm capitalize">${fee.feeType}</td>
                <td class="px-4 py-3 text-sm">₹${fee.amountDue.toLocaleString()}</td>
                <td class="px-4 py-3 text-sm">₹${fee.amountPaid.toLocaleString()}</td>
                <td class="px-4 py-3 text-sm font-semibold">₹${balance.toLocaleString()}</td>
                <td class="px-4 py-3">
                    <span class="px-2 py-1 text-xs rounded-full ${getFeeStatusClass(fee.status)}">
                        ${fee.status.charAt(0).toUpperCase() + fee.status.slice(1)}
                    </span>
                </td>
                <td class="px-4 py-3 text-sm">
                    <button onclick="recordPayment('${fee._id}')" class="text-green-600 hover:text-green-800 mr-2">Pay</button>
                    <button onclick="editFee('${fee._id}')" class="text-blue-600 hover:text-blue-800">Edit</button>
                </td>
            </tr>
        `;
    }).join('');
}

function getFeeStatusClass(status) {
    const classes = {
        paid: 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400',
        pending: 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-400',
        partial: 'bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-400',
        overdue: 'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-400'
    };
    return classes[status] || classes.pending;
}

function updateFeesPagination(pagination) {
    document.getElementById('fees-start').textContent = (pagination.page - 1) * pagination.limit + 1;
    document.getElementById('fees-end').textContent = Math.min(pagination.page * pagination.limit, pagination.total);
    document.getElementById('fees-total').textContent = pagination.total;
}

function previousFeesPage() {
    if (feesPage > 1) {
        feesPage--;
        loadFees();
    }
}

function nextFeesPage() {
    feesPage++;
    loadFees();
