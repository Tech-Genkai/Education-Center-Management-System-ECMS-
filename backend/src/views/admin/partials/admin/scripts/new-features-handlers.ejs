                    courseSelect.appendChild(opt);
                });
            }
        }
    } catch (e) { console.error('Error loading fees courses', e); }
}

function onFeesCourseChange(val) {
    // Optional: cascade logic if needed
}

function onFeesSemesterChange(val) {
    // Optional: cascade logic if needed
