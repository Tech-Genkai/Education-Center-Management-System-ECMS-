// Populate class and subject dropdowns
async function populateDropdownsForNewTabs() {
    try {
        // Load classes for all dropdowns
        const classesResponse = await fetch('/api/classes', { credentials: 'include' });
        const classesData = await classesResponse.json();
        
        if (classesData.classes) {
            const classSelects = [
                'attendance-class',
                'marks-class',
                'filter-class',
                'assignment-class-filter'
            ];
            
            classSelects.forEach(selectId => {
                const select = document.getElementById(selectId);
                if (select) {
                    select.innerHTML = '<option value="">Select Class</option>' +
                        classesData.classes.map(cls => 
                            `<option value="${cls._id}">${cls.className}</option>`
                        ).join('');
                }
            });
        }

        // Load subjects for all dropdowns
        const subjectsResponse = await fetch('/api/subjects', { credentials: 'include' });
        const subjectsData = await subjectsResponse.json();
        
        if (subjectsData.subjects) {
            const subjectSelects = [
                'attendance-subject',
                'marks-subject'
            ];
            
            subjectSelects.forEach(selectId => {
                const select = document.getElementById(selectId);
                if (select) {
                    select.innerHTML = '<option value="">Select Subject</option>' +
                        subjectsData.subjects.map(subject => 
                            `<option value="${subject._id}">${subject.subjectName}</option>`
                        ).join('');
                }
            });
        }
    } catch (error) {
        console.error('Error populating dropdowns:', error);
    }
}

