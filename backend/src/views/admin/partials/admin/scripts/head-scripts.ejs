<script>
    /**
     * Head Scripts
     * Contains: Alpine.js config, load functions for students/teachers/admins, profile picture functions
     */

    // Global data storage for search functionality
    window.allStudents = [];
    window.allTeachers = [];
    window.allAdmins = [];

    // Search functions
    function filterStudents(searchTerm) {
        const filtered = window.allStudents.filter(student => {
            const fullName = `${student.firstName} ${student.lastName}`.toLowerCase();
            const email = (student.userId && student.userId.email) || '';
            const studentId = student.studentId || '';
            const currentClass = student.currentClass || '';
            
            return fullName.includes(searchTerm.toLowerCase()) ||
                   email.toLowerCase().includes(searchTerm.toLowerCase()) ||
                   studentId.toLowerCase().includes(searchTerm.toLowerCase()) ||
                   currentClass.toLowerCase().includes(searchTerm.toLowerCase());
        });
        renderStudents(filtered);
    }

    function filterTeachers(searchTerm) {
        const filtered = window.allTeachers.filter(teacher => {
            const fullName = `${teacher.firstName} ${teacher.lastName}`.toLowerCase();
            const email = (teacher.userId && teacher.userId.email) || '';
            const teacherId = teacher.teacherId || '';
            const department = teacher.department || '';
            
            return fullName.includes(searchTerm.toLowerCase()) ||
                   email.toLowerCase().includes(searchTerm.toLowerCase()) ||
                   teacherId.toLowerCase().includes(searchTerm.toLowerCase()) ||
                   department.toLowerCase().includes(searchTerm.toLowerCase());
        });
        renderTeachers(filtered);
    }

    function filterAdmins(searchTerm) {
        const filtered = window.allAdmins.filter(admin => {
            const fullName = `${admin.firstName} ${admin.lastName}`.toLowerCase();
            const email = (admin.userId && admin.userId.email) || '';
            const adminId = admin.adminId || '';
            const designation = admin.designation || '';
            
            return fullName.includes(searchTerm.toLowerCase()) ||
                   email.toLowerCase().includes(searchTerm.toLowerCase()) ||
                   adminId.toLowerCase().includes(searchTerm.toLowerCase()) ||
                   designation.toLowerCase().includes(searchTerm.toLowerCase());
        });
        renderAdmins(filtered);
    }

    // Render functions (extracted from load functions)
    function renderStudents(students) {
        const tbody = document.getElementById('studentsTableBody');
        
