<!-- Dashboard Overview Tab -->
<div class="space-y-6">
    <!-- Welcome Banner -->
    <div class="glass-card rounded-2xl p-6 bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700/50">
        <div class="relative z-10 flex items-center justify-between">
            <div>
                <h2 class="text-3xl font-extrabold text-gray-900 dark:text-white text-3d tracking-tight">Welcome back, <span x-text="user.name"></span>! 👋</h2>
                <p class="text-gray-600 dark:text-gray-300 mt-2 font-medium">Here's what's happening with your academic journey.</p>
            </div>
            <div class="hidden md:block">
                <img src="/static/images/student-illustration.svg" alt="Student" class="h-24 opacity-80" onerror="this.style.display='none'">
            </div>
        </div>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Total Classes -->
        <div class="glass-card rounded-xl shadow-md p-6 border-l-4 border-blue-500">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-600 dark:text-gray-400 text-3d">Total Classes</p>
                    <p class="text-3xl font-bold text-gray-900 dark:text-white mt-2 text-3d" x-text="stats.totalClasses"></p>
                </div>
                <div class="p-3 bg-blue-100 dark:bg-blue-900/30 rounded-lg">
                    <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                    </svg>
                </div>
            </div>
        </div>

        <!-- Attendance -->
        <div class="glass-card rounded-xl shadow-md p-6 border-l-4 border-green-500">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-600 dark:text-gray-400 text-3d">Attendance</p>
                    <p class="text-3xl font-bold text-gray-900 dark:text-white mt-2 text-3d"><span x-text="stats.attendance"></span>%</p>
                </div>
                <div class="p-3 bg-green-100 dark:bg-green-900/30 rounded-lg">
                    <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
            </div>
        </div>

        <!-- Pending Assignments -->
        <div class="glass-card rounded-xl shadow-md p-6 border-l-4 border-yellow-500">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-600 dark:text-gray-400 text-3d">Pending Tasks</p>
                    <p class="text-3xl font-bold text-gray-900 dark:text-white mt-2 text-3d" x-text="stats.pendingAssignments"></p>
                </div>
                <div class="p-3 bg-yellow-100 dark:bg-yellow-900/30 rounded-lg">
                    <svg class="w-8 h-8 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
            </div>
        </div>

        <!-- Average Grade -->
        <div class="glass-card rounded-xl shadow-md p-6 border-l-4 border-purple-500">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-600 dark:text-gray-400 text-3d">Avg. Grade</p>
                    <p class="text-3xl font-bold text-gray-900 dark:text-white mt-2 text-3d"><span x-text="stats.averageGrade"></span>%</p>
                </div>
                <div class="p-3 bg-purple-100 dark:bg-purple-900/30 rounded-lg">
                    <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Today's Schedule -->
        <div class="lg:col-span-2 glass-card rounded-xl shadow-md p-6">
            <div class="flex items-center justify-between mb-6">
                <h3 class="text-lg font-bold text-gray-900 dark:text-white text-3d">Today's Schedule</h3>
                <button @click="setTab('timetable')" class="text-sm text-blue-600 dark:text-blue-400 hover:underline">View All</button>
            </div>
            <div class="space-y-4">
                <% if (schedule && schedule.length > 0) { %>
                    <% schedule.forEach(function(item) { %>
                    <div class="flex items-center p-4 bg-<%= item.color %>-50 dark:bg-<%= item.color %>-900/20 rounded-lg">
                        <div class="flex-shrink-0 w-2 h-12 bg-<%= item.color %>-500 rounded-full mr-4"></div>
                        <div class="flex-1">
                            <p class="font-semibold text-gray-900 dark:text-white text-3d"><%= item.subject %></p>
                            <p class="text-sm text-gray-500 dark:text-gray-400"><%= item.time %> • <%= item.room %></p>
                        </div>
                    </div>
                    <% }); %>
                <% } else { %>
                    <p class="text-gray-500 dark:text-gray-400 text-center py-8 text-3d">No classes scheduled for today</p>
                <% } %>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="glass-card rounded-xl shadow-md p-6">
            <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-4 text-3d">Quick Actions</h3>
            <div class="space-y-3">
                <button @click="setTab('profile')" class="w-full flex items-center px-4 py-3 bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-lg hover:bg-blue-100 dark:hover:bg-blue-900/50 transition">
                    <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                    <span class="font-medium text-sm text-3d">View Profile</span>
                </button>
                <button @click="setTab('fees')" class="w-full flex items-center px-4 py-3 bg-green-50 dark:bg-green-900/30 text-green-700 dark:text-green-300 rounded-lg hover:bg-green-100 dark:hover:bg-green-900/50 transition">
                    <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <span class="font-medium text-sm text-3d">Check Fees</span>
                </button>
                <button @click="setTab('leave')" class="w-full flex items-center px-4 py-3 bg-yellow-50 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-300 rounded-lg hover:bg-yellow-100 dark:hover:bg-yellow-900/50 transition">
                    <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <span class="font-medium text-sm text-3d">Apply for Leave</span>
                </button>
                <button @click="setTab('contact')" class="w-full flex items-center px-4 py-3 bg-purple-50 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 rounded-lg hover:bg-purple-100 dark:hover:bg-purple-900/50 transition">
                    <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                    <span class="font-medium text-sm text-3d">Contact Mentor</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Announcements -->
    <div class="glass-card rounded-xl shadow-md p-6">
        <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-4 text-3d">Recent Announcements</h3>
        <div class="space-y-3">
            <% if (announcements && announcements.length > 0) { %>
                <% announcements.forEach(function(item) { %>
                <div class="flex items-start p-4 bg-<%= item.color %>-50 dark:bg-<%= item.color %>-900/20 rounded-lg border-l-4 border-<%= item.color %>-500">
                    <div class="flex-1">
                        <p class="font-semibold text-gray-900 dark:text-white text-3d"><%= item.title %></p>
                        <p class="text-sm text-gray-500 dark:text-gray-400"><%= item.date %></p>
                    </div>
                </div>
                <% }); %>
            <% } else { %>
                <p class="text-gray-500 dark:text-gray-400 text-center py-4 text-3d">No announcements</p>
            <% } %>
        </div>
    </div>
</div>
