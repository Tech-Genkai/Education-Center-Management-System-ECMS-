<!-- Fees Tab -->
<div class="space-y-6">
    <!-- Page Header -->
    <div class="glass-card rounded-xl shadow-md p-6">
        <div class="flex items-center justify-between">
            <div>
                <h2 class="text-2xl font-bold text-gray-900 dark:text-white text-3d">Fee Details</h2>
                <p class="text-gray-500 dark:text-gray-400 mt-1">View your fee structure and payment history</p>
            </div>
            <button class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition font-medium text-sm">
                Download Receipt
            </button>
        </div>
    </div>

    <!-- Fee Summary Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="glass-card rounded-xl shadow-md p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-500 dark:text-gray-400 text-3d">Total Fees</p>
                    <p class="text-2xl font-bold text-gray-900 dark:text-white mt-1 text-3d">₹<%= fees.total || '0' %></p>
                </div>
                <div class="p-3 bg-blue-100 dark:bg-blue-900/30 rounded-lg">
                    <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/>
                    </svg>
                </div>
            </div>
        </div>
        <div class="glass-card rounded-xl shadow-md p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-500 dark:text-gray-400 text-3d">Paid</p>
                    <p class="text-2xl font-bold text-green-600 dark:text-green-400 mt-1 text-3d">₹<%= fees.paid || '0' %></p>
                </div>
                <div class="p-3 bg-green-100 dark:bg-green-900/30 rounded-lg">
                    <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
            </div>
        </div>
        <div class="glass-card rounded-xl shadow-md p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-500 dark:text-gray-400 text-3d">Pending</p>
                    <p class="text-2xl font-bold text-red-600 dark:text-red-400 mt-1 text-3d">₹<%= fees.pending || '0' %></p>
                </div>
                <div class="p-3 bg-red-100 dark:bg-red-900/30 rounded-lg">
                    <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <!-- Fee Structure -->
    <div class="glass-card rounded-xl shadow-md p-6">
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4 text-3d">Fee Structure</h3>
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead>
                    <tr class="border-b border-gray-200 dark:border-gray-700">
                        <th class="text-left py-3 px-4 text-sm font-semibold text-gray-700 dark:text-gray-300">Description</th>
                        <th class="text-right py-3 px-4 text-sm font-semibold text-gray-700 dark:text-gray-300">Amount</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                    <% if (feeStructure && feeStructure.length > 0) { %>
                        <% feeStructure.forEach(function(item) { %>
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-800/50">
                            <td class="py-3 px-4 text-sm text-gray-900 dark:text-white"><%= item.description %></td>
                            <td class="py-3 px-4 text-sm text-gray-900 dark:text-white text-right">₹<%= item.amount %></td>
                        </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="2" class="py-8 text-center text-gray-500 dark:text-gray-400">No fee structure available</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Payment History -->
    <div class="glass-card rounded-xl shadow-md p-6">
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4 text-3d">Payment History</h3>
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead>
                    <tr class="border-b border-gray-200 dark:border-gray-700">
                        <th class="text-left py-3 px-4 text-sm font-semibold text-gray-700 dark:text-gray-300">Date</th>
                        <th class="text-left py-3 px-4 text-sm font-semibold text-gray-700 dark:text-gray-300">Description</th>
                        <th class="text-right py-3 px-4 text-sm font-semibold text-gray-700 dark:text-gray-300">Amount</th>
                        <th class="text-center py-3 px-4 text-sm font-semibold text-gray-700 dark:text-gray-300">Status</th>
                        <th class="text-center py-3 px-4 text-sm font-semibold text-gray-700 dark:text-gray-300">Receipt</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                    <% if (paymentHistory && paymentHistory.length > 0) { %>
                        <% paymentHistory.forEach(function(payment) { %>
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-800/50">
                            <td class="py-3 px-4 text-sm text-gray-900 dark:text-white"><%= payment.date %></td>
                            <td class="py-3 px-4 text-sm text-gray-600 dark:text-gray-300"><%= payment.description %></td>
                            <td class="py-3 px-4 text-sm text-gray-900 dark:text-white text-right">₹<%= payment.amount %></td>
                            <td class="py-3 px-4 text-center">
                                <span class="px-2 py-1 text-xs rounded-full font-medium 
                                    <%= payment.status === 'Paid' ? 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-300' : 'bg-yellow-100 text-yellow-700 dark:bg-yellow-900/30 dark:text-yellow-300' %>">
                                    <%= payment.status %>
                                </span>
                            </td>
                            <td class="py-3 px-4 text-center">
                                <button class="text-blue-600 dark:text-blue-400 hover:underline text-sm">Download</button>
                            </td>
                        </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" class="py-8 text-center text-gray-500 dark:text-gray-400">No payment history available</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>
