<!-- Syllabus Tab -->
<div class="space-y-6">
    <!-- Page Header -->
    <div class="glass-card rounded-xl shadow-md p-6">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white text-3d">Course Syllabus</h2>
        <p class="text-gray-500 dark:text-gray-400 mt-1">View syllabus for your enrolled subjects</p>
    </div>

    <!-- Subject Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% if (subjects && subjects.length > 0) { %>
            <% subjects.forEach(function(subject, index) { %>
            <div class="glass-card rounded-xl shadow-md p-6 hover:shadow-lg transition-shadow">
                <div class="flex items-start justify-between mb-4">
                    <div class="p-3 bg-<%= ['blue', 'green', 'purple', 'yellow', 'pink', 'indigo'][index % 6] %>-100 dark:bg-<%= ['blue', 'green', 'purple', 'yellow', 'pink', 'indigo'][index % 6] %>-900/30 rounded-lg">
                        <svg class="w-6 h-6 text-<%= ['blue', 'green', 'purple', 'yellow', 'pink', 'indigo'][index % 6] %>-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                        </svg>
                    </div>
                    <span class="text-xs px-2 py-1 bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 rounded-full"><%= subject.code %></span>
                </div>
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2 text-3d"><%= subject.name %></h3>
                <p class="text-sm text-gray-500 dark:text-gray-400 mb-4"><%= subject.credits || 3 %> Credits • <%= subject.type || 'Core' %></p>
                <div class="flex items-center justify-between">
                    <span class="text-sm text-gray-500 dark:text-gray-400">
                        <% if (subject.teacher) { %>
                            <%= subject.teacher %>
                        <% } else { %>
                            No teacher assigned
                        <% } %>
                    </span>
                    <button class="text-blue-600 dark:text-blue-400 text-sm font-medium hover:underline">
                        View Syllabus →
                    </button>
                </div>
            </div>
            <% }); %>
        <% } else { %>
            <div class="col-span-full text-center py-12">
                <svg class="w-16 h-16 text-gray-300 dark:text-gray-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                </svg>
                <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-2 text-3d">No Subjects Found</h3>
                <p class="text-gray-500 dark:text-gray-400">Subjects will appear here once you are enrolled in courses.</p>
            </div>
        <% } %>
    </div>
</div>
