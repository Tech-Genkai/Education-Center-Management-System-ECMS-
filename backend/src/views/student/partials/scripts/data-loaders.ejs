<script>
    // Profile Picture Upload Functions with Cropper.js
    window.selectedFile = null;
    window.originalImageSrc = null;
    window.cropper = null;
    window.showCropModal = false;
    
    window.handleProfilePictureChange = function(event) {
        const file = event.target.files[0];
        if (!file) return;
        
        // Validate file type
        const allowedTypes = ['image/jpeg', 'image/png', 'image/webp'];
        if (!allowedTypes.includes(file.type)) {
            alert('Please select a valid image file (JPG, PNG, or WEBP)');
            event.target.value = '';
            return;
        }
        
        // Validate file size (5MB max for cropping, will be smaller after crop)
        const maxSize = 5 * 1024 * 1024;
        if (file.size > maxSize) {
            alert('File size must be less than 5MB');
            event.target.value = '';
            return;
        }
        
        // Store original image if not already stored
        if (!window.originalImageSrc) {
            window.originalImageSrc = document.getElementById('profilePicturePreview').src;
        }
        
        // Show crop modal with the selected image
        const reader = new FileReader();
        reader.onload = function(e) {
            showCropperModal(e.target.result);
        };
        reader.readAsDataURL(file);
    };

    window.showCropperModal = function(imageSrc) {
        // Create modal if it doesn't exist
        let modal = document.getElementById('cropperModal');
        if (!modal) {
            modal = document.createElement('div');
            modal.id = 'cropperModal';
            modal.innerHTML = `
                <div class="fixed inset-0 bg-black/70 backdrop-blur-sm z-[9999] flex items-center justify-center p-4">
                    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-2xl w-full max-w-2xl overflow-hidden">
                        <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700 flex items-center justify-between">
                            <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Crop Profile Photo</h3>
                            <button onclick="closeCropperModal()" class="p-2 text-gray-400 hover:text-gray-600 transition">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                            </button>
                        </div>
                        <div class="p-6">
                            <div class="relative w-full" style="max-height: 400px; overflow: hidden;">
                                <img id="cropperImage" src="" style="max-width: 100%; display: block;">
                            </div>
                            <div class="flex items-center justify-center gap-4 mt-4">
                                <button onclick="rotateCropperLeft()" class="p-2 bg-gray-100 dark:bg-gray-700 rounded-lg hover:bg-gray-200 dark:hover:bg-gray-600 transition" title="Rotate Left">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/></svg>
                                </button>
                                <button onclick="rotateCropperRight()" class="p-2 bg-gray-100 dark:bg-gray-700 rounded-lg hover:bg-gray-200 dark:hover:bg-gray-600 transition" title="Rotate Right">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 10H11a8 8 0 00-8 8v2M21 10l-6 6m6-6l-6-6"/></svg>
                                </button>
                                <button onclick="flipCropperX()" class="p-2 bg-gray-100 dark:bg-gray-700 rounded-lg hover:bg-gray-200 dark:hover:bg-gray-600 transition" title="Flip Horizontal">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h8M8 12h8M8 17h8"/></svg>
                                </button>
                                <button onclick="resetCropper()" class="p-2 bg-gray-100 dark:bg-gray-700 rounded-lg hover:bg-gray-200 dark:hover:bg-gray-600 transition" title="Reset">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                                </button>
                            </div>
                        </div>
                        <div class="px-6 py-4 border-t border-gray-200 dark:border-gray-700 flex justify-end gap-3">
                            <button onclick="closeCropperModal()" class="px-4 py-2 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg transition">Cancel</button>
                            <button onclick="applyCrop()" class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition">Apply & Upload</button>
                        </div>
                    </div>
                </div>
            `;
            document.body.appendChild(modal);
        }
        
        // Set image source
        const cropperImage = document.getElementById('cropperImage');
        cropperImage.src = imageSrc;
        
        // Destroy existing cropper if any
        if (window.cropper) {
            window.cropper.destroy();
        }
        
        // Initialize Cropper.js
        window.cropper = new Cropper(cropperImage, {
            aspectRatio: 1,
            viewMode: 1,
            dragMode: 'move',
            autoCropArea: 0.8,
            restore: false,
            guides: true,
            center: true,
            highlight: false,
            cropBoxMovable: true,
            cropBoxResizable: true,
            toggleDragModeOnDblclick: false,
            ready: function() {
                // Cropper is ready
            }
        });
        
        modal.style.display = 'block';
    };
    
    window.closeCropperModal = function() {
        const modal = document.getElementById('cropperModal');
        if (modal) {
            modal.style.display = 'none';
        }
        if (window.cropper) {
            window.cropper.destroy();
            window.cropper = null;
        }
        document.getElementById('profilePictureInput').value = '';
    };
    
    window.rotateCropperLeft = function() {
        if (window.cropper) window.cropper.rotate(-90);
    };
    
    window.rotateCropperRight = function() {
        if (window.cropper) window.cropper.rotate(90);
    };
    
    window.flipCropperX = function() {
        if (window.cropper) {
            const scaleX = window.cropper.getData().scaleX || 1;
            window.cropper.scaleX(-scaleX);
        }
    };
    
    window.resetCropper = function() {
        if (window.cropper) window.cropper.reset();
    };
    
    window.applyCrop = async function() {
        if (!window.cropper) return;
        
        try {
            // Get cropped canvas
            const canvas = window.cropper.getCroppedCanvas({
                width: 400,
                height: 400,
                imageSmoothingEnabled: true,
                imageSmoothingQuality: 'high'
            });
            
            if (!canvas) {
                alert('Failed to crop image');
                return;
            }
            
            // Convert to blob
            canvas.toBlob(async (blob) => {
                if (!blob) {
                    alert('Failed to process image');
                    return;
                }
                
                // Create form data
                const formData = new FormData();
                formData.append('image', blob, 'profile.jpg');
                
                // Get user ID
                const dashboardEl = document.querySelector('[x-data]');
                const userId = dashboardEl?.__x?.$data?.user?._id || '';
                formData.append('userId', userId);
                
                // Show loading
                const applyBtn = document.querySelector('#cropperModal button:last-child');
                const originalText = applyBtn?.textContent;
                if (applyBtn) {
                    applyBtn.disabled = true;
                    applyBtn.textContent = 'Uploading...';
                }
                
                try {
                    const response = await fetch('/api/profile/avatar', {
                        method: 'POST',
                        body: formData,
                        credentials: 'include'
                    });
                    
                    if (response.ok) {
                        alert('Profile picture updated successfully!');
                        closeCropperModal();
                        window.location.reload();
                    } else {
                        const error = await response.json();
                        alert('Error: ' + (error.message || 'Failed to upload picture'));
                    }
                } catch (error) {
                    console.error('Error:', error);
                    alert('Failed to upload picture. Please try again.');
                } finally {
                    if (applyBtn) {
                        applyBtn.disabled = false;
                        applyBtn.textContent = originalText;
                    }
                }
            }, 'image/jpeg', 0.9);
        } catch (error) {
            console.error('Crop error:', error);
            alert('Failed to crop image. Please try again.');
        }
    };

    window.cancelProfilePictureUpload = function() {
        window.selectedFile = null;
        if (window.originalImageSrc) {
            document.getElementById('profilePicturePreview').src = window.originalImageSrc;
        }
        document.getElementById('uploadControls').classList.add('hidden');
        document.getElementById('profilePictureInput').value = '';
    };

    window.uploadProfilePicture = async function() {
        // This function is kept for backward compatibility but now uses cropper
        document.getElementById('profilePictureInput').click();
    };
</script>
