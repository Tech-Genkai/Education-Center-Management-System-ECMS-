{
  "version": 2,
  "buildCommand": "cd backend && npm install && npm run build",
  "installCommand": "npm install && cd backend && npm install && cd ../shared && npm install",
  "framework": null,
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs18.x",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/static/(.*)", "destination": "/api" },
    { "source": "/docs/(.*)", "destination": "/api" },
    { "source": "/healthz", "destination": "/api" },
    { "source": "/(.*)", "destination": "/api" }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
